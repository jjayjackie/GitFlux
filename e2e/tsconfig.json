{
  // Playwright specs, their fixtures and the Playwright configuration. Specs run in Node; code passed to
  // page.evaluate runs in the browser, hence the DOM library.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "allowJs": true,
    "checkJs": false
  },
  "include": ["./**/*.ts", "./**/*.mjs", "../playwright.config.ts"],
  "exclude": ["./.artifacts"]
}
